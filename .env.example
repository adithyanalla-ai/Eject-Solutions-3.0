# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://ejectsolutions.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@ejectsolutions.com   # [[CONFIRM]] real inbox
NEXT_PUBLIC_PHONE=                                    # [[CONFIRM]] e.g. +91 XXXXX XXXXX (omitted from schema/UI when empty)
NEXT_PUBLIC_WHATSAPP_NUMBER=                          # digits only with country code, e.g. 919XXXXXXXXX

# ---- Analytics (loaded only after cookie consent) ----
NEXT_PUBLIC_GA4_ID=                                   # G-XXXXXXXXXX

# ---- Search engine verification ----
NEXT_PUBLIC_GSC_VERIFICATION=                         # Google Search Console meta token
NEXT_PUBLIC_BING_VERIFICATION=                        # Bing Webmaster meta token

# ---- Email delivery (Resend) ----
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@ejectsolutions.com             # where leads are delivered
MAIL_FROM="Eject Solutions <no-reply@ejectsolutions.com>"   # domain must be verified in Resend
RESEND_AUDIENCE_ID=                                   # optional: confirmed newsletter subscribers are added here

# ---- Newsletter double opt-in ----
NEWSLETTER_SECRET=                                    # long random string; signs confirmation links

# ---- Spam protection (optional but recommended) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Content pipeline (GitHub Actions secrets/vars, not needed on Vercel) ----
ANTHROPIC_API_KEY=                                    # optional: enables LLM-written drafts; without it, editor skeletons are generated
ANTHROPIC_MODEL=                                      # set to the model id you want drafts written with
